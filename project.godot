; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Goosespeed"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03529412, 0.105882354, 0.16862746, 1)
config/icon="uid://cpll7mvn0f4gx"

[autoload]

GooseGameSettings="*res://scripts/gameplay/goose_game_settings.gd"
CoinWallet="*res://scripts/gameplay/coin_wallet.gd"
LevelProgress="*res://scripts/gameplay/level_progress.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
Settings="*res://addons/goose-moves/scripts/settings.gd"
KeybindingsSettings="*res://addons/goose-moves/scripts/keybindings_settings.gd"
GooseHonk="*res://scripts/audio/goose_honk.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

